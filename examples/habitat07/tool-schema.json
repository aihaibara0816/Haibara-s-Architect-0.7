{
  "name": "ha_scene_add_modules",
  "description": "Add bounded modules to the host-approved scene; host alone chooses execution and paths.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "modules"
    ],
    "properties": {
      "modules": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "recipe",
            "origin"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "recipe": {
              "type": "string",
              "enum": [
                "tree",
                "planter",
                "reading-room",
                "workshop-bay",
                "pipe-rack",
                "fixed-roof-tank"
              ]
            },
            "origin": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 159
              }
            }
          }
        }
      }
    }
  }
}
