      "region": "roof/eave/upper facade/shopfront",
      "observation": "深灰坡顶、连续下层挑檐；上层细格窗，下层较大营业开口；招牌和暖帘落在营业侧。",
      "component": "shop.frontage",
      "proposed_rule": "先锁檐线、柱距、入口，再按营业界面配置陈列，不逐格随机开窗。"
    },
    {
      "id": "obs-f02",
      "source_id": "src-shop",
      "time": "~00:49 (repost)",
      "region": "plan",
      "observation": "准备基底画面标注 12 与 9，铺地内部有不同分区。",
      "component": "shop.base",
      "proposed_rule": "可做 12×9 基底构件试验；非整栋含檐包围盒，不能推导米制尺寸。"
    },
    {
      "id": "obs-f03",
      "source_id": "src-inn",
      "time": "~00:15,00:33 (repost)",
      "region": "front facade/interior",
      "observation": "双层横向檐线、成组窗格、居中入口；内景有深木、浅色面板、窗边植栽和悬挂灯。",
      "component": "inn.facade_and_interior",
      "proposed_rule": "旅馆采用重复房间节奏，但公共入口与窗后层单独设计。"
    },
    {
      "id": "obs-f04",
      "source_id": "src-garden",
      "time": "opening,00:39 (repost)",
      "region": "roof/courtyard",
      "observation": "高低屋面组合围出庭院；院内台阶、石路、植栽与小构筑物共同形成路径。",
      "component": "house.courtyard",
      "proposed_rule": "先划院落与穿行路线，再布树和道具；主屋、门屋分体量。"
    },
