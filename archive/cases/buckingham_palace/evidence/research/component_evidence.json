      "source_ids": "bp_osm;bp_aerial_royal",
      "parameters": "plan; frame.plan_offset_xz",
      "consumer": "Palace.__init__ / mass",
      "confidence": "平面中高；各翼高度中低"
    },
    {
      "component_id": "east_front",
      "decision": "23 窗列分成 3—7—3—7—3；柱、山花、檐口、阳台分层，玻璃内退。",
      "source_ids": "listing;bp_aerial;bp_balcony",
      "parameters": "front",
      "consumer": "Palace.east_front",
      "confidence": "中高；纹饰近似"
    },
    {
      "component_id": "west_front",
      "decision": "较暖石色；大窗、小上窗、成对柱、弧形中央凸部与绿色半穹顶。",
      "source_ids": "bp_west;bp_west_2019",
      "parameters": "case source: west_front",
      "consumer": "Palace.west_front",
      "confidence": "中；位置与装饰还需精修"
    },
    {
      "component_id": "court",
      "decision": "内院独立柱廊，入口玻璃雨篷有黑色骨架、下表面与支撑。",
      "source_ids": "bp_access p10;bp_aerial",
      "parameters": "case source: courtyard_portico",
      "consumer": "Palace.courtyard_portico",
      "confidence": "中；尺寸为照片估计"
    },
    {
      "component_id": "rooms",
      "decision": "窗洞贯穿外墙后接有深度的小开间；家具与占灯基于稳定 ID。",
      "source_ids": "bp_access p18;HAF interior rules",
      "parameters": "seed",
      "consumer": "Facade.window; hafusion.interiors / lighting",
      "confidence": "仅伪内饰；真实房间还原未实施"
    },
    {
      "component_id": "night",
      "decision": "固定檐口灯与随机窗灯分别控制；前庭灯和纪念碑灯独立。",
      "source_ids": "bp_night",
      "parameters": "seed; case fixture constants",
      "consumer": "Palace.east_front / gates_and_memorial",
      "confidence": "中低；灯具点位估算"
    },
    {
      "component_id": "site",
      "decision": "红色前庭、金属围栏、浅色石墩、简化纪念碑与花园边缘。",
      "source_ids": "bp_aerial_royal;bp_aerial",
      "parameters": "site",
      "consumer": "Palace.site / gates_and_memorial / landscape",
      "confidence": "中低；喷泉用静态玻璃代理"
    }
  ],
  "limitations": [
    "地图高度不等于测绘高度；主正面按 108 米宽校准，屋顶、各翼和局部雕饰为估计。",
    "窗后家具是可重复的伪内饰；不宣称还原真实房间布局或全部房间。",
    "维多利亚纪念碑雕塑、喷泉和种植被简化；不是完整景观还原。",
    "静态英国旗只是模型标识，不表示当日王室是否在宫内。"
