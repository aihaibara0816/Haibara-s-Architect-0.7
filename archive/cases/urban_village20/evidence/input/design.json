  "design_brief": {
    "title": "榕荫里 · 六边坡街",
    "hard_constraints": [
      "20栋，保留混合尺度、逐户内饰与生活外饰",
      "整片街区六边形边界；北边短折线与斜边",
      "东、南主街与人行道；西北留空",
      "E1长度60格",
      "东南街角至西北最高行走面8格高差",
      "D5二层以上斜角可进入阳台",
      "住宅约70%亮灯"
    ],
    "assumptions": [
      "六边形是街区，不是所有单栋都做六边形",
      "地块、道路与高程为原创设计，非测绘或工程合规",
      "20栋既有楼层数不变；地面台地高程、门口、楼梯及设备一起抬升",
      "选择少量多转折楼板，避免所有建筑只采用单一削角"
    ],
    "revision_reason": "V3形态获正面反馈；延长一栋到60格、总高差取8格、整片街区采用用户六边形边界，D5斜面改可进入阳台，并少量增加多转折单栋轮廓。"
  },
