  "design_brief": {
    "title": "榕荫里 · 长街短巷",
    "hard_constraints": [
      "20栋",
      "东侧及南侧临主街",
      "西北留空且略高",
      "非矩形体块与斜切转角",
      "临街底商、独立住宅入口和部分双入口",
      "完整内饰、外饰与低强度旧化",
      "沿街长楼与内巷小宅的占地差异清楚",
      "不保留贯穿场地的等距四行五列网格",
      "入口、通道及内饰根据新轮廓重新生成"
    ],
    "assumptions": [
      "西北最高完成面Y=7，东南人行道Y=3，车道Y=2",
      "4格场地总高差，使用缓坡台阶与平整建筑台地",
      "住宅约70%亮灯；公共空间和商铺保持照明",
      "地块和巷道为原创构图，不声称测绘、结构或消防合规",
      "最长沿街面49格，最小宅地22×16格；街面与内侧进深分别设计"
    ],
    "revision_reason": "V2楼栋尺度相近、行列和间距过齐；V3改为长条临街楼与碎地块混合，入口和内饰同步重排。"
